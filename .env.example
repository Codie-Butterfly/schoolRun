# Local defaults. Never put real keys in source control.
PORT=9200
BIND_ADDRESS=127.0.0.1
# Production: jdbc:postgresql://database-host:5432/schoolrun
DATABASE_URL=jdbc:h2:file:./data/schoolrun;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
DATABASE_USER=sa
DATABASE_PASSWORD=
UPLOADS_DIR=./data/private-files
# Awaiting business confirmation. Zero blocks payment initiation.
SUBSCRIPTION_PRICE=0
SUBSCRIPTION_UNIT=CUSTOMER
SUBSCRIPTION_CURRENCY=USD
PAYNOW_ENABLED=false
PAYNOW_TEST_MODE=true
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_TEST_EMAIL=
PAYNOW_TEST_DRIVER_IDS=
PUBLIC_BASE_URL=
